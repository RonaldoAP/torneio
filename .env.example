# ==== Supabase (público — vai para o browser) ====
# Necessário para o modo AO VIVO (o que o admin faz espelha para todos).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# ==== Servidor (NUNCA exponha estes no browser) ====
# Usada pelas rotas /api/admin para gravar no banco contornando o RLS.
# Pegue em: Supabase > Project Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Slug secreto do painel de admin (sem senha — quem tem o link administra).
# O admin fica em:  https://SEU-SITE/painel/<ADMIN_SLUG>
# Use algo longo e difícil de adivinhar. Enquanto NÃO estiver definido, o admin
# fica acessível em /admin (modo local, um dispositivo).
ADMIN_SLUG=troque-por-uma-slug-secreta-longa
